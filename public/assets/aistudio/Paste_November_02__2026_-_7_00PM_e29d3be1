          hcBeams.forEach(b => {
            const n1 = hcNodes[b.u], n2 = hcNodes[b.v];
            if (!n1 || !n2) return;
            const dx = n2.x - n1.x, dy = n2.y - n1.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            const strain = Math.abs(dist - b.rest) / b.rest;
