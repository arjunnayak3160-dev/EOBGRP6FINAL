    function stepWebPhysics() {
      const kRad = silk === 'major_ampullate' ? 0.40 : silk === 'flagelliform' ? 0.17 : 0.92;
      const kSpi = silk === 'major_ampullate' ? 0.19 : silk === 'flagelliform' ? 0.09 : 0.86;
      const rupture = silk === 'major_ampullate' ? 1.68 : silk === 'flagelliform' ? 2.65 : 1.12;

