    function initHcLattice() {
      hcNodes = []; hcBeams = []; hcCells = [];
      const w = hcCanvas.width, h = hcCanvas.height;
      const nodeMap = new Map();

      if (hcModel === 'building') {
        const raftY = 248, bedrockY = 380;
        const bLeft = 140, bRight = w - 140;
        const R = 22, W = R * 1.5, H = R * Math.sqrt(3);
        const cols = Math.ceil((bRight - bLeft) / W) + 1;
        const rows = Math.ceil((bedrockY - raftY) / H) + 1;

        function getFNode(x, y) {
          const cy = Math.max(raftY, Math.min(bedrockY, y));
          const k = `${Math.round(x*10)},${Math.round(cy*10)}`;
          if (nodeMap.has(k)) return nodeMap.get(k);
          const id = hcNodes.length;
          const isTop = Math.abs(cy - raftY) < 4.0;
          const isBot = Math.abs(cy - bedrockY) < 4.0;
          hcNodes.push({ x, y: cy, bx: x, by: cy, vx: 0, vy: 0, fixed: isBot, isTop, mass: isTop ? 18 : isBot ? 50 : 2.5 });
          nodeMap.set(k, id);
          return id;
        }

        for (let c = -1; c <= cols; c++) {
          for (let r = 0; r <= rows; r++) {
            const cx = bLeft + c * W;
            const cy = raftY + r * H + ((c % 2 !== 0) ? H / 2 : 0);
            if (cx >= bLeft - 10 && cx <= bRight + 10 && cy >= raftY - 10 && cy <= bedrockY + 10) {
              const cellIdxs = [];
              for (let i = 0; i < 6; i++) {
                const a = (Math.PI / 3) * i;
                const px = Math.max(bLeft, Math.min(bRight, cx + R * Math.cos(a)));
                const py = cy + R * Math.sin(a);
                cellIdxs.push(getFNode(px, py));
              }
              if (cx >= bLeft + R && cx <= bRight - R && cy >= raftY + R && cy <= bedrockY - R) {
                hcCells.push({ indices: [...cellIdxs] });
              }
              for (let i = 0; i < 6; i++) {
                const u = cellIdxs[i], v = cellIdxs[(i + 1) % 6];
                if (u !== v && !hcBeams.some(b => (b.u === u && b.v === v) || (b.u === v && b.v === u))) {
                  const d = Math.hypot(hcNodes[v].x - hcNodes[u].x, hcNodes[v].y - hcNodes[u].y);
                  if (d > 2) hcBeams.push({ u, v, rest: d, stress: 0, yielded: false });
                }
              }
            }
          }
        }
        hcSway = { angle: 0, vAngle: 0, topX: 380 };

      } else {
        const pTop = 82, pBot = 368;
        const xMin = 70, xMax = w - 70;
        const R = Math.max(14, panelCellL * 1.35);
        const W = R * 1.5, H = R * Math.sqrt(3);

        function getPNode(x, y) {
          const cy = Math.max(pTop, Math.min(pBot, y));
          const k = `${Math.round(x*10)},${Math.round(cy*10)}`;
          if (nodeMap.has(k)) return nodeMap.get(k);
          const id = hcNodes.length;
          const isTop = Math.abs(cy - pTop) < 3.5;
          const isBot = Math.abs(cy - pBot) < 3.5;
          hcNodes.push({ x, y: cy, bx: x, by: cy, vx: 0, vy: 0, fixed: isBot, isTop, mass: (isTop||isBot)?10:1 });
          nodeMap.set(k, id);
          return id;
        }

        const cols = Math.ceil((xMax - xMin) / W) + 2;
        const rows = Math.ceil((pBot - pTop) / H) + 2;

        for (let c = -1; c <= cols; c++) {
          for (let r = -1; r <= rows; r++) {
            const cx = xMin + c * W;
            const cy = pTop + r * H + ((c % 2 !== 0) ? H / 2 : 0);
            let inside = false;
            for (let i = 0; i < 6; i++) {
              const a = (Math.PI / 3) * i;
              const px = cx + R * Math.cos(a), py = cy + R * Math.sin(a);
              if (px >= xMin - 15 && px <= xMax + 15 && py >= pTop - 10 && py <= pBot + 10) inside = true;
            }
            if (inside) {
              const cellIdxs = [];
              for (let i = 0; i < 6; i++) {
                const a = (Math.PI / 3) * i;
                const px = Math.max(xMin, Math.min(xMax, cx + R * Math.cos(a)));
                const py = cy + R * Math.sin(a);
                cellIdxs.push(getPNode(px, py));
              }
              if (cx >= xMin + R && cx <= xMax - R && cy >= pTop + R && cy <= pBot - R) {
                hcCells.push({ indices: [...cellIdxs] });
              }
              for (let i = 0; i < 6; i++) {
                const u = cellIdxs[i], v = cellIdxs[(i + 1) % 6];
                if (u !== v && !hcBeams.some(b => (b.u === u && b.v === v) || (b.u === v && b.v === u))) {
                  const d = Math.hypot(hcNodes[v].x - hcNodes[u].x, hcNodes[v].y - hcNodes[u].y);
                  if (d > 2) hcBeams.push({ u, v, rest: d, stress: 0, yielded: false });
                }
              }
            }
          }
        }
        hcTopPlaten = { y: pTop, by: pTop, vy: 0 };
        hcCrash = { y: -60, vy: 0, active: false };
      }
    }

    function stepHcPhysics() {
      simTime += 0.016;

      if (hcModel === 'building') {
        const totalGravity = bldgFloors * 920;
        const fK = (foundWallT / 120) * 8.5;
        let groundX = 0;
        let axialForce = totalGravity * 0.0007;

        if (hcEvent === 'seismic_shear') {
          const amp = seismicPGA * 34;
          groundX = Math.sin(simTime * 8.5) * amp + Math.sin(simTime * 16) * (amp * 0.3);
          hcNodes.forEach(n => { if (n.fixed) n.x = n.bx + groundX; });
          hcSway.vAngle += groundX * 0.0018;
        } else if (hcEvent === 'wind_overturning') {
          const wind = Math.sin(simTime * 4) * 28 + 35;
          hcSway.vAngle += (wind * 0.025) * 0.004;
          hcNodes.forEach(n => { if (n.fixed) n.x = n.bx; });
        } else if (hcEvent === 'settlement') {
          hcNodes.forEach(n => { if (n.fixed) n.y = n.by + (n.bx > 380 ? 16 : 0); });
        } else if (hcEvent === 'buckling_test') {
          axialForce *= 2.8;
          hcNodes.forEach(n => { if (n.fixed) n.x = n.bx; });
        } else {
          hcNodes.forEach(n => { if (n.fixed) { n.x = n.bx; n.y = n.by; } });
        }

        hcSway.vAngle += -hcSway.angle * 0.055;
        hcSway.vAngle *= 0.94;
        hcSway.angle += hcSway.vAngle;
        hcSway.topX = 380 + Math.sin(hcSway.angle) * 190;

        const tilt = Math.sin(hcSway.angle) * 12;
        hcNodes.forEach(n => {
          if (n.isTop) {
            const rel = (n.bx - 380) / 240;
            n.y = n.by + (axialForce * 0.2) + rel * tilt;
            n.x = n.bx + Math.sin(hcSway.angle) * 8;
          }
        });

        let maxStress = 0;
        for (let iter = 0; iter < 12; iter++) {
          hcBeams.forEach(b => {
            const n1 = hcNodes[b.u], n2 = hcNodes[b.v];
            if (!n1 || !n2) return;
            const dx = n2.x - n1.x, dy = n2.y - n1.y;
            const dist = Math.hypot(dx, dy) || 0.001;
            const strain = Math.abs(dist - b.rest) / b.rest;
            b.stress = Math.min(1.0, strain * 4.8);
            maxStress = Math.max(maxStress, b.stress * 180);

            if (strain > 0.24 && !b.yielded) {
              b.yielded = true;
              b.rest *= 0.90;
            }

            const diff = (dist - b.rest) / dist;
            const corrX = dx * diff * 0.5 * (fK * 0.035);
            const corrY = dy * diff * 0.5 * (fK * 0.035);
            if (!n1.fixed && !n1.isTop) { n1.x += corrX; n1.y += corrY; }
            if (!n2.fixed && !n2.isTop) { n2.x -= corrX; n2.y -= corrY; }
          });
        }

        hcNodes.forEach(n => {
          if (n.fixed || n.isTop) return;
          n.vx += (n.bx - n.x) * 0.05;
          n.vy += (n.by - n.y) * 0.05;
          n.vx *= 0.88; n.vy *= 0.88;
          n.x += n.vx; n.y += n.vy;
        });

        hcOsc.shift();
        hcOsc.push(maxStress);

        const drift = Math.abs(hcSway.angle * (180 / Math.PI)).toFixed(2);
        const sf = Math.max(0.3, 240 / (maxStress * 0.9 + 10)).toFixed(1);
        document.getElementById('hc-kpi-1').innerText = (Math.min(92, 70 + (foundWallT / 180) * 12)).toFixed(1) + '%';
        document.getElementById('hc-kpi-2').innerText = maxStress.toFixed(1) + ' MPa';
        document.getElementById('hc-kpi-3').innerText = drift + '°';
        document.getElementById('hc-kpi-4').innerText = sf + 'x';

      } else {
        let topForceY = panelLoadF * 0.18;
        let lateralX = 0;

        if (panelEvent === 'earthquake') {
          const shake = Math.sin(simTime * 11) * 26 + Math.sin(simTime * 21) * 7;
          hcNodes.forEach(n => { if (n.fixed) n.x = n.bx + shake; });
        } else if (panelEvent === 'flutter') {
          lateralX = Math.sin(simTime * 19) * 35;
          topForceY += Math.sin(simTime * 9.5) * 16;
        } else if (panelEvent === 'crash') {
          if (hcCrash.active) {
            hcCrash.vy += 0.38;
            hcCrash.y += hcCrash.vy;
            if (hcCrash.y >= hcTopPlaten.y - 12) {
              hcCrash.y = hcTopPlaten.y - 12;
              topForceY += hcCrash.vy * 50;
              hcCrash.vy *= -0.15;
              if (Math.abs(hcCrash.vy) < 0.4) hcCrash.active = false;
            }
          }
        } else {
          hcNodes.forEach(n => { if (n.fixed) n.x = n.bx; });
        }

