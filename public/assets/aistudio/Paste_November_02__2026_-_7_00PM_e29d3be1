    function initWeb() {
      webNodes = []; webEdges = []; webShockwaves = [];
      const cx = webCanvas.width / 2, cy = webCanvas.height / 2;
      const spokes = 14, rings = [0, 38, 76, 115, 155, 195];
      let nId = 0, eId = 0;

      webNodes.push({ id: nId++, x: cx, y: cy, oldX: cx, oldY: cy, bx: cx, by: cy, vx: 0, vy: 0, fixed: false, spoke: -1 });

      for (let r = 1; r < rings.length; r++) {
        const rad = rings[r], isAnchor = r === rings.length - 1;
        for (let s = 0; s < spokes; s++) {
          const a = (s * 2 * Math.PI) / spokes;
          const px = cx + rad * Math.cos(a), py = cy + rad * Math.sin(a);
          webNodes.push({ id: nId++, x: px, y: py, oldX: px, oldY: py, bx: px, by: py, vx: 0, vy: 0, fixed: isAnchor, spoke: s });
        }
      }

      for (let s = 0; s < spokes; s++) {
        webEdges.push({ id: eId++, u: 0, v: 1 + s, rest: rings[1], broken: false, type: 'radial', strain: 0 });
        for (let r = 1; r < rings.length - 1; r++) {
          const u = 1 + (r - 1) * spokes + s, v = 1 + r * spokes + s;
          const d = Math.hypot(webNodes[v].x - webNodes[u].x, webNodes[v].y - webNodes[u].y);
          webEdges.push({ id: eId++, u, v, rest: d, broken: false, type: 'radial', strain: 0 });
        }
      }

      for (let r = 1; r < rings.length; r++) {
        const off = 1 + (r - 1) * spokes;
        for (let s = 0; s < spokes; s++) {
          const u = off + s, v = off + ((s + 1) % spokes);
          const d = Math.hypot(webNodes[v].x - webNodes[u].x, webNodes[v].y - webNodes[u].y);
          webEdges.push({ id: eId++, u, v, rest: d, broken: false, type: 'spiral', strain: 0 });
        }
      }

      webWindParts = [];
      for (let i = 0; i < 40; i++) {
        webWindParts.push({ x: Math.random() * 760, y: Math.random() * 440, vx: 4 + Math.random() * 6, vy: (Math.random() - 0.5) * 1.5 });
