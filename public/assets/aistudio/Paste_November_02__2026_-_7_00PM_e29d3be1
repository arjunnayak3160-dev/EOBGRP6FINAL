      });

      webWindParts.forEach(p => {
        p.x += p.vx + (windSpeed / 25);
        p.y += p.vy;
        if (p.x > 760) { p.x = 0; p.y = Math.random() * 440; }
      });

      for (let i = webShockwaves.length - 1; i >= 0; i--) {
        const sw = webShockwaves[i];
        sw.r += 3.5; sw.alpha -= 0.035;
        if (sw.alpha <= 0) webShockwaves.splice(i, 1);
      }

      webOscHistory.shift();
      webOscHistory.push(webNodes[0] ? Math.hypot(webNodes[0].x - webNodes[0].bx, webNodes[0].y - webNodes[0].by) : 0);
    }

    function renderWeb() {
      const w = webCanvas.width, h = webCanvas.height;
      webCtx.clearRect(0, 0, w, h);
      webCtx.fillStyle = '#061224';
      webCtx.fillRect(0, 0, w, h);

      if (webEvent === 'wind') {
        webWindParts.forEach(p => {
          webCtx.beginPath();
          webCtx.moveTo(p.x, p.y);
          webCtx.lineTo(p.x + p.vx * 3.5, p.y + p.vy);
          webCtx.strokeStyle = 'rgba(147, 197, 253, 0.4)';
          webCtx.lineWidth = 1;
          webCtx.stroke();
        });
      }

      webShockwaves.forEach(sw => {
        webCtx.beginPath();
        webCtx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);
        webCtx.strokeStyle = `rgba(239, 68, 68, ${sw.alpha})`;
        webCtx.lineWidth = 2;
        webCtx.stroke();
      });

      webEdges.forEach(e => {
        if (e.broken) return;
        const n1 = webNodes[e.u], n2 = webNodes[e.v];
        if (!n1 || !n2) return;
        const s = e.strain || 1.0;
        webCtx.beginPath();
        webCtx.moveTo(n1.x, n1.y);
        webCtx.lineTo(n2.x, n2.y);
        webCtx.strokeStyle = s > 1.35 ? '#ef4444' : s > 1.15 ? '#facc15' : e.type === 'radial' ? '#93c5fd' : '#bfdbfe';
        webCtx.lineWidth = e.type === 'radial' ? 2.2 : 1.3;
        webCtx.stroke();
      });

      webNodes.forEach(n => {
        if (n.fixed) {
          webCtx.beginPath();
          webCtx.arc(n.x, n.y, 5, 0, Math.PI * 2);
          webCtx.fillStyle = '#10b981';
          webCtx.fill();
        } else {
          webCtx.beginPath();
          webCtx.arc(n.x, n.y, 3.2, 0, Math.PI * 2);
          webCtx.fillStyle = webDragId === n.id ? '#facc15' : '#93c5fd';
          webCtx.fill();
        }
      });

      if (webNodes[0]) {
        webCtx.beginPath();
        webCtx.arc(webNodes[0].x, webNodes[0].y, 7, 0, Math.PI * 2);
        webCtx.fillStyle = '#facc15';
        webCtx.fill();
      }

      if (webProj.active) {
        webCtx.beginPath();
        webCtx.arc(webProj.x, webProj.y, 8, 0, Math.PI * 2);
        webCtx.fillStyle = '#ef4444';
        webCtx.fill();
      }

      const ox = 18, oy = h - 85, ow = 200, oh = 65;
      webCtx.fillStyle = 'rgba(8, 22, 40, 0.9)';
      webCtx.fillRect(ox, oy, ow, oh);
      webCtx.strokeRect(ox, oy, ow, oh);
      webCtx.fillStyle = '#93c5fd';
      webCtx.font = 'bold 9px monospace';
      webCtx.fillText('HUB DISPLACEMENT (μm)', ox + 8, oy + 14);

      webCtx.beginPath();
      webCtx.strokeStyle = webEvent === 'impact' ? '#ef4444' : '#93c5fd';
      webCtx.lineWidth = 1.8;
      for (let i = 0; i < webOscHistory.length; i++) {
        const px = ox + 6 + (i / webOscHistory.length) * (ow - 12);
        const py = oy + oh - 6 - Math.min(oh - 24, webOscHistory[i] * 1.8);
        if (i === 0) webCtx.moveTo(px, py); else webCtx.lineTo(px, py);
      }
      webCtx.stroke();

      stepWebPhysics();
      requestAnimationFrame(renderWeb);
    }

    webCanvas.addEventListener('mousedown', e => {
      const rect = webCanvas.getBoundingClientRect();
      const x = e.clientX - rect.left, y = e.clientY - rect.top;
      webMouse = { x, y };

      if (webEvent === 'cut') {
        for (let edge of webEdges) {
          if (edge.broken) continue;
          const n1 = webNodes[edge.u], n2 = webNodes[edge.v];
          const midX = (n1.x + n2.x) / 2, midY = (n1.y + n2.y) / 2;
          if (Math.hypot(x - midX, y - midY) < 18) {
            edge.broken = true;
            webShockwaves.push({ x: midX, y: midY, r: 3, alpha: 0.9 });
            updateWebStats();
            break;
          }
        }
        return;
      }

      let closest = null, minD = 30;
      for (let n of webNodes) {
        if (n.fixed) continue;
        const d = Math.hypot(n.x - x, n.y - y);
        if (d < minD) { minD = d; closest = n.id; }
      }
      if (closest !== null) webDragId = closest;
    });

    webCanvas.addEventListener('mousemove', e => {
      const rect = webCanvas.getBoundingClientRect();
      webMouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    });
    window.addEventListener('mouseup', () => { webDragId = null; });

    document.getElementById('input-wind').addEventListener('input', e => {
      windSpeed = parseInt(e.target.value);
      document.getElementById('label-wind').innerText = windSpeed + ' km/h';
    });

    initWeb();
    renderWeb();
  </script>
