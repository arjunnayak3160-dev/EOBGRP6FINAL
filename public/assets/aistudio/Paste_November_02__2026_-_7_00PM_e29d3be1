          if (!n1.fixed && webDragId !== n1.id) { n1.x += ox; n1.y += oy; }
          if (!n2.fixed && webDragId !== n2.id) { n2.x -= ox; n2.y -= oy; }
        });
      }

      webNodes.forEach(n => {
        if (n.fixed) return;
